# ==============================================================================
# Revenue Sentinel - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# WARNING: Never commit actual keys, tokens, or credentials to Git.
# ==============================================================================

# Application Environment (development, production)
ENV=development
PROJECT_NAME="Revenue Sentinel"

# Payment Recovery Gateway Mode
# Options:
#   mock: Runs simulated recovery retries (default for tests and local development)
#   razorpay: Runs simulated API connections with live configuration checks
PAYMENT_PROVIDER_MODE=mock

# Razorpay Credentials (Required only when PAYMENT_PROVIDER_MODE=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook Authentication
# Used to verify SHA-256 signatures of incoming payment failure notifications
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_sentinel
